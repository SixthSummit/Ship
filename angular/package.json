{
  "name": "ship-angular",
  "version": "5.0.0",
  "private": true,
  "description": "ShipAngular Framework",
  "author": "Scott Gibson",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -w exec turbo run build --filter=@sixthsummit/ship-angular --filter=@sixthsummit/ship-angular-docs",
    "docs:dev": "pnpm --filter @sixthsummit/ship-angular-docs dev",
    "docs:build": "pnpm --filter @sixthsummit/ship-angular-docs build",
    "docs:preview": "pnpm --filter @sixthsummit/ship-angular-docs preview",
    "test": "pnpm -w exec turbo run test --filter=@sixthsummit/ship-angular",
    "test:watch": "pnpm --filter @sixthsummit/ship-angular test:watch",
    "test:coverage": "pnpm -w exec turbo run test:coverage --filter=@sixthsummit/ship-angular",
    "test:packed-conformance": "node scripts/verify-packed-conformance.mjs",
    "test:joint-conformance": "node scripts/verify-packed-conformance.mjs --require-external --manifest ../.ship/joint/manifest.json",
    "test:browser-conformance": "node scripts/run-browser-conformance.mjs && node scripts/verify-push-browser.mjs",
    "lint": "cd .. && angular/node_modules/.bin/eslint --config angular/eslint.config.js angular packages/angular apps/angular-docs && pnpm --filter ship-angular imports:check",
    "lint:fix": "cd .. && angular/node_modules/.bin/eslint --fix --config angular/eslint.config.js angular packages/angular apps/angular-docs && pnpm --filter ship-angular imports:check",
    "imports:check": "node scripts/format-workspace.mjs imports",
    "imports:fix": "node scripts/format-workspace.mjs imports --write",
    "format": "node scripts/format-workspace.mjs format --write",
    "format:check": "node scripts/format-workspace.mjs format",
    "type-check": "pnpm -w exec turbo run type-check --filter=@sixthsummit/ship-angular --filter=@sixthsummit/ship-angular-docs",
    "sync-version": "node scripts/sync-version.js",
    "changeset": "pnpm -w run changeset",
    "version-packages": "pnpm -w run version-packages",
    "release": "pnpm -w run release",
    "measure-bundle": "node scripts/measure-bundle.js",
    "measure-bundle:enforce": "node scripts/measure-bundle.js --enforce",
    "evals": "pnpm evals:validate",
    "evals:validate": "node evals/validate.js",
    "evals:run": "node evals/run.js",
    "knip": "knip",
    "size-limit": "size-limit",
    "ci": "pnpm sync-version && pnpm type-check && pnpm lint && pnpm format:check && pnpm evals:validate && pnpm build && pnpm test:coverage && pnpm test:query-example && pnpm test:packed-conformance && pnpm test:query-conformance && pnpm test:browser-conformance && pnpm test:joint-conformance && pnpm measure-bundle:enforce && pnpm knip && pnpm run audit",
    "pre-commit": "pnpm sync-version && pnpm type-check && pnpm lint && pnpm format:check && pnpm test",
    "audit": "pnpm test:http-cache-security && pnpm audit --audit-level=high",
    "test:query-example": "tsc -p conformance/query-example/tsconfig.json && vitest run --config conformance/query-example/vitest.config.ts --coverage",
    "test:query-conformance": "node scripts/verify-query-package.mjs",
    "test:http-cache-security": "node --test scripts/http-cache-security.test.mjs",
    "test:artifact-download": "node --test --experimental-test-coverage --test-coverage-include='scripts/download-core-artifact.mjs' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 scripts/download-core-artifact.test.mjs"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "20.3.36",
    "@angular/core": "20.3.34",
    "@angular/platform-server": "20.3.34",
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "knip": "^6.40.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "size-limit": "^14.2.0",
    "socket.io": "^4.8.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "astro": "^7.3.8"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
