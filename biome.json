{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "dev"
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/lib",
      "!!**/dist",
      "!!**/coverage",
      "!!apps/docs/.astro",
      "!!packages/*/templates",
      "!!pnpm-lock.yaml",
      "!!**/drizzle/meta",
      "!!**/schema.snapshot.json",
      "!!angular",
      "!!packages/angular",
      "!!apps/angular-docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": "off",
      "correctness": {
        "noUnusedFunctionParameters": "off"
      },
      "performance": "off",
      "style": "off",
      "suspicious": {
        "noConfusingVoidType": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noTemplateCurlyInString": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noThenProperty": "off"
          }
        }
      }
    }
  ]
}
