{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "composite": true,
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["src/**/*.js"],
  "exclude": ["lib", "node_modules", "src/**/*.test.js", "src/**/__fixtures__/**"]
}
