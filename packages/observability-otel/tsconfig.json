{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["lib", "node_modules", "src/**/*.test.ts", "src/**/*.typecheck.ts"]
}
