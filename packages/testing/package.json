{
  "name": "@sixthsummit/ship-testing",
  "version": "1.2.1",
  "description": "Portable parity fixtures and real PostgreSQL test harnesses for Ship applications",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./parity": {
      "types": "./lib/parity.d.ts",
      "import": "./lib/parity.js",
      "default": "./lib/parity.js"
    },
    "./postgres": {
      "types": "./lib/postgres.d.ts",
      "import": "./lib/postgres.js",
      "default": "./lib/postgres.js"
    },
    "./outbox": {
      "types": "./lib/outbox.d.ts",
      "import": "./lib/outbox.js",
      "default": "./lib/outbox.js"
    },
    "./cache": {
      "types": "./lib/cache.d.ts",
      "import": "./lib/cache.js",
      "default": "./lib/cache.js"
    },
    "./realtime": {
      "types": "./lib/realtime.d.ts",
      "import": "./lib/realtime.js",
      "default": "./lib/realtime.js"
    },
    "./webhooks": {
      "types": "./lib/webhooks.d.ts",
      "import": "./lib/webhooks.js",
      "default": "./lib/webhooks.js"
    },
    "./jobs": {
      "types": "./lib/jobs.d.ts",
      "import": "./lib/jobs.js",
      "default": "./lib/jobs.js"
    },
    "./jobs-conformance": {
      "types": "./lib/jobs-conformance.d.ts",
      "import": "./lib/jobs-conformance.js",
      "default": "./lib/jobs-conformance.js"
    },
    "./storage": {
      "types": "./lib/storage.d.ts",
      "import": "./lib/storage.js",
      "default": "./lib/storage.js"
    }
  },
  "sideEffects": false,
  "files": [
    "lib/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run --root ../.. packages/testing/src",
    "test:coverage": "vitest run --root ../.. packages/testing/src --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@testcontainers/postgresql": "^12.0.1",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.16.3"
  },
  "peerDependencies": {
    "@sixthsummit/ship-core": "workspace:^",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@sixthsummit/ship-core": "workspace:*",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "drizzle-orm": "^0.45.2",
    "ws": "^8.20.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SixthSummit/Ship.git",
    "directory": "packages/testing"
  }
}
