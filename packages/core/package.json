{
  "name": "@sixthsummit/ship-api",
  "version": "4.1.1",
  "description": "ShipAPI Framework — TypeScript backend on Hono + Drizzle + pluggable AuthProvider + BullMQ + OpenTelemetry. Designed to be edited by AI coding agents.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "ship-api": "./cli/ship-api.js"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc && node ../../scripts/build-core.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit -p tsconfig.check.json"
  },
  "keywords": [
    "typescript",
    "hono",
    "drizzle",
    "firebase",
    "api",
    "framework",
    "rest",
    "rpc",
    "authentication",
    "authorization",
    "middleware",
    "bullmq",
    "opentelemetry",
    "ai-agents",
    "claude-code",
    "boilerplate",
    "cli"
  ],
  "author": "Scott Gibson",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./contract": {
      "types": "./lib/contract/index.d.ts",
      "import": "./lib/contract/index.js",
      "default": "./lib/contract/index.js"
    },
    "./contract/application": {
      "types": "./lib/contract/application.d.ts",
      "import": "./lib/contract/application.js",
      "default": "./lib/contract/application.js"
    },
    "./contract/openapi": {
      "types": "./lib/contract/openapi.d.ts",
      "import": "./lib/contract/openapi.js",
      "default": "./lib/contract/openapi.js"
    },
    "./contract/project": {
      "types": "./lib/contract/project.d.ts",
      "import": "./lib/contract/project.js",
      "default": "./lib/contract/project.js"
    },
    "./contract/schema": {
      "types": "./lib/contract/schema.d.ts",
      "import": "./lib/contract/schema.js",
      "default": "./lib/contract/schema.js"
    },
    "./hono": {
      "types": "./lib/hono/index.d.ts",
      "import": "./lib/hono/index.js",
      "default": "./lib/hono/index.js"
    },
    "./drizzle": {
      "types": "./lib/drizzle/index.d.ts",
      "import": "./lib/drizzle/index.js",
      "default": "./lib/drizzle/index.js"
    },
    "./kernel": {
      "types": "./lib/kernel/index.d.ts",
      "import": "./lib/kernel/index.js",
      "default": "./lib/kernel/index.js"
    },
    "./rate-limit": {
      "types": "./lib/app/services/rateLimit/index.d.ts",
      "import": "./lib/app/services/rateLimit/index.js",
      "default": "./lib/app/services/rateLimit/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js",
      "default": "./lib/*.js"
    }
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/node-ws": "^1.3.0",
    "@hono/zod-validator": "^0.7.6",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-prometheus": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sixthsummit/ship-cli": "workspace:^",
    "@sixthsummit/ship-contract": "workspace:^",
    "@sixthsummit/ship-core": "workspace:^",
    "@sixthsummit/ship-drizzle": "workspace:^",
    "@sixthsummit/ship-hono": "workspace:^",
    "@sixthsummit/ship-observability-otel": "workspace:^",
    "async": "^3.2.4",
    "bullmq": "^5.76.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "file-type": "^21.3.4",
    "firebase-admin": "^13.10.0",
    "hono": "^4.13.13",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "lru-cache": "^11.3.5",
    "msgpackr": "^1.11.10",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.3",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "@sixthsummit/ship-testing": "workspace:^",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@sixthsummit/ship-testing": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib/",
    "cli/ship-api.js",
    "cli/commands/add.js",
    "cli/commands/contract.js",
    "cli/commands/create.js",
    "cli/commands/dev.js",
    "cli/commands/doctor.js",
    "cli/commands/generate.js",
    "cli/commands/graph.js",
    "cli/commands/migrate-orm.js",
    "cli/commands/update.js",
    "templates/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SixthSummit/Ship.git",
    "directory": "packages/core"
  },
  "devDependencies": {
    "@sixthsummit/ship-testing": "workspace:^",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@bull-board/api": "^7.0.0",
    "@bull-board/hono": "^7.0.0",
    "@google-cloud/storage": "^7.19.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@testcontainers/localstack": "^12.0.1",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^12.0.1"
  }
}
