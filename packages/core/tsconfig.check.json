{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "outDir": "lib"
  },
  "include": ["src/**/*.ts", "../../modules/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "src/**/examples/**",
    "../../modules/**/*.test.ts",
    "../../modules/**/*.integration.test.ts",
    "node_modules",
    "lib"
  ]
}
