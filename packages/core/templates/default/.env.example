# Required ─────────────────────────────────────────────────────────────

# Postgres connection string — used by both runtime + drizzle-kit.
DATABASE_URL=postgres://ship_api:ship_api@localhost:5432/ship_api

# HMAC-SHA256 secret for OAuth state signing. ≥32 random bytes,
# rotated separately from JWT keys. Do not commit.
#
# Zero-downtime rotation: the framework's `StateSecret` type accepts
# either a single string OR an ordered array (head signs, tail still
# verifies). During a rotation window, source two env vars in your
# environment.ts and pass `[env.OAUTH_STATE_SECRET_NEW, env.OAUTH_STATE_SECRET_OLD]`
# as `stateSecret` to defineOAuthRoutes; once the rotation window
# (default 10 min) has fully drained, drop OLD from the array.
OAUTH_STATE_SECRET=replace-with-32-random-bytes

# JWT signing — ES256 key pair. Rotate via add-new-key →
# cut-signing → drain-old-key. The signing key is private; the
# verification keys are a JSON array of JWKS supporting >1 key
# during rotation windows.
JWT_SIGNING_KEY=
JWT_VERIFICATION_KEYS=[]

# Optional ─────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS allowlist (comma-separated). When set, the framework wires
# `hono/cors` with `credentials: true` against this list. Required if
# your TypeScript client lives on a different origin from the API.
#
# `CORS_ORIGINS=*` is NOT supported with cookie auth — browsers reject
# the wildcard + credentials combo, and `createApp()` throws at boot
# rather than letting the misconfig sit silently. Use explicit origins:
#
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
#
# Leave unset for a single-origin deployment (same domain for API + web).
CORS_ORIGINS=

# OpenTelemetry — disable in test, enable + point at a collector
# in prod. The auto-instrumentations cover HTTP / pg / ioredis /
# undici / pino with no per-call wiring.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ship-api-app
ENVIRONMENT_NAME=development

# Prometheus metrics exporter (independent port, off by default).
METRICS_ENABLED=false
METRICS_PORT=9464

# Redis — required when using rate limiting / cache / BullMQ.
REDIS_URL=redis://localhost:6379

# Admin API key for the Bull-Board dashboard (and other admin
# surfaces). ≥32 random bytes. Required only when you mount the
# dashboard via `createBullBoardApp({ apiKey: env.ADMIN_API_KEY })`.
# DO NOT expose the dashboard on a public hostname even with the key
# set — operators should additionally guard at the network edge
# (private subnet / VPN / ingress allowlist).
ADMIN_API_KEY=

# Firebase auth (the v4.0 default AuthProvider). Replace with
# Better-Auth / Clerk / WorkOS / Auth.js adapter creds when you
# swap providers.
FIREBASE_CREDENTIALS=

# OAuth provider credentials. Add only the providers your app
# supports — the credentials resolver returns null for unconfigured
# providers and the routes layer 400s with a clear message.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:3000/oauth/microsoft/callback
