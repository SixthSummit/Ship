{
  "name": "ship-api-app",
  "version": "0.0.1",
  "description": "ShipAPI v4 application",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "ship-api dev",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:baseline": "drizzle-kit introspect && drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.7.6",
    "@sixthsummit/ship-observability-otel": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "firebase-admin": "^13.10.0",
    "hono": "^4.12.15",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
