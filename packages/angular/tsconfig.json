{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "useUnknownInCatchVariables": false,
    "strictPropertyInitialization": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "@sixthsummit/ship-angular": ["./src/public-api.ts"],
      "@sixthsummit/ship-angular/operations": ["./operations/src/public-api.ts"],
      "@sixthsummit/ship-angular/ship-api": ["./ship-api/src/public-api.ts"],
      "@sixthsummit/ship-angular/hono-v4": ["./hono-v4/src/public-api.ts"],
      "@sixthsummit/ship-angular/legacy-rest": ["./legacy-rest/src/public-api.ts"],
      "@sixthsummit/ship-angular/auth": ["./auth/src/public-api.ts"],
      "@sixthsummit/ship-angular/firebase-auth": ["./firebase-auth/src/public-api.ts"],
      "@sixthsummit/ship-angular/download": ["./download/src/public-api.ts"],
      "@sixthsummit/ship-angular/upload": ["./upload/src/public-api.ts"],
      "@sixthsummit/ship-angular/stream": ["./stream/src/public-api.ts"],
      "@sixthsummit/ship-angular/socket": ["./socket/src/public-api.ts"],
      "@sixthsummit/ship-angular/realtime": ["./realtime/src/public-api.ts"],
      "@sixthsummit/ship-angular/forms": ["./forms/src/public-api.ts"],
      "@sixthsummit/ship-angular/query": ["./query/src/public-api.ts"],
      "@sixthsummit/ship-angular/push": ["./push/src/public-api.ts"],
      "@sixthsummit/ship-angular/console": ["./console/src/public-api.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "node_modules", "lib"]
}
