{
  "name": "{{PROJECT_NAME}}",
  "version": "0.0.1",
  "description": "{{PROJECT_DESCRIPTION}}",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod": "ng build --configuration production",
    "build:ssr": "ng build --configuration production",
    "serve:ssr": "node dist/{{PROJECT_NAME}}/server/server.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\" && pnpm imports:check",
    "lint:fix": "eslint \"src/**/*.ts\" \"src/**/*.html\" --fix && pnpm imports:fix",
    "imports:check": "biome check --formatter-enabled=false --linter-enabled=false .",
    "imports:fix": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "format": "biome format --write . && prettier --write \"src/**/*.{html,scss}\"",
    "format:check": "biome format . && prettier --check \"src/**/*.{html,scss}\"",
    "type-check": "tsc --noEmit",
    "i18n:extract": "ng extract-i18n --output-path src/locale",
    "ci": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm build-prod",
    "noop": "echo 'No operation needed for static site'"
  },
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "dependencies": {
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/fire": "^20.1.0",
    "@angular/forms": "^20.3.33",
    "@angular/localize": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/platform-server": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@angular/ssr": "^20.3.36",
    "@sixthsummit/ship-angular": "^4.1.0",
    "express": "^4.21.0",
    "firebase": "^11.10.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@analogjs/vite-plugin-angular": "^2.8.0",
    "@analogjs/vitest-angular": "^2.8.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "20.3.39",
    "@angular/cli": "^20.3.36",
    "@angular/compiler-cli": "^20.3.33",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.1",
    "jsdom": "^27.4.0",
    "msw": "^2.6.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "msw",
      "protobufjs"
    ],
    "overrides": {
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@>=4": "^5.0.12",
      "fast-uri": "^3.1.8",
      "source-map-js": "^1.2.2",
      "@firebase/firestore>@grpc/grpc-js": "^1.13.6",
      "@angular/build@20.3.39>vitest": "4.1.11"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
