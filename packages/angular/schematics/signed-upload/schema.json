{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ShipAngularGenerateSignedUpload",
  "title": "ShipAngular: generate signed upload",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Signed-upload service name:"
    },
    "bindingPackage": {
      "type": "string",
      "default": "@my-org/ship-api-client"
    },
    "bindingName": {
      "type": "string",
      "description": "Generated OperationSignedUploadBinding export."
    },
    "apiImport": {
      "type": "string",
      "default": "../../api"
    },
    "path": {
      "type": "string",
      "default": "src/app/services"
    }
  },
  "required": ["name"]
}
