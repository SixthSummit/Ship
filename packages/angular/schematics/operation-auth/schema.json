{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ShipAngularGenerateOperationAuth",
  "title": "ShipAngular: generate operation session auth",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Session auth boundary name (for example 'app').",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Session auth boundary name (for example 'app'):"
    },
    "meOperationId": {
      "type": "string",
      "description": "Stable current-session operation ID.",
      "default": "auth.me"
    },
    "signInOperationId": {
      "type": "string",
      "description": "Stable password sign-in operation ID; pass an empty string to omit.",
      "default": "auth.login"
    },
    "registerOperationId": {
      "type": "string",
      "description": "Optional stable registration operation ID."
    },
    "signOutOperationId": {
      "type": "string",
      "description": "Stable sign-out operation ID; pass an empty string to omit.",
      "default": "auth.logout"
    },
    "refreshOperationId": {
      "type": "string",
      "description": "Stable session-refresh operation ID; pass an empty string to omit.",
      "default": "auth.refresh"
    },
    "contractPackage": {
      "type": "string",
      "description": "Browser-safe package exporting the application contract type.",
      "default": "@my-org/ship-api-contract"
    },
    "contractType": {
      "type": "string",
      "description": "Application contract type exported by contractPackage.",
      "default": "AppContract"
    },
    "apiImport": {
      "type": "string",
      "description": "Import path to the generated application API boundary.",
      "default": "../api"
    },
    "path": {
      "type": "string",
      "description": "Directory to scaffold under.",
      "default": "src/auth"
    }
  },
  "required": ["name"]
}
