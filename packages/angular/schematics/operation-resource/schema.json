{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "ShipAngularGenerateOperationResource",
  "title": "ShipAngular: generate operation resource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Resource name (for example 'account-detail').",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Resource name (for example 'account-detail'):"
    },
    "operationId": {
      "type": "string",
      "description": "Stable HTTP operation ID from the packed application contract.",
      "default": "accounts.get"
    },
    "contractPackage": {
      "type": "string",
      "description": "Browser-safe package exporting the application contract type.",
      "default": "@my-org/ship-api-contract"
    },
    "contractType": {
      "type": "string",
      "description": "Application contract type exported by contractPackage.",
      "default": "AppContract"
    },
    "apiImport": {
      "type": "string",
      "description": "Import path to the generated application API boundary.",
      "default": "../../api"
    },
    "path": {
      "type": "string",
      "description": "Directory to scaffold under.",
      "default": "src/app/resources"
    }
  },
  "required": ["name"]
}
