{
  "name": "@sixthsummit/ship-schema-lint",
  "version": "0.0.0",
  "description": "Migration linter, schema snapshot check, and gated release preset for Drizzle PostgreSQL migrations in Ship applications",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "ship-schema-lint": "./lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "lib/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run --root ../.. packages/schema-lint/src --exclude '**/*.integration.test.ts'",
    "test:coverage": "vitest run --root ../.. packages/schema-lint/src --exclude '**/*.integration.test.ts' --coverage"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@sixthsummit/ship-testing": "workspace:^",
    "@types/pg": "^8.15.6",
    "drizzle-orm": "^0.45.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SixthSummit/Ship.git",
    "directory": "packages/schema-lint"
  }
}
