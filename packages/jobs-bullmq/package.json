{
  "name": "@sixthsummit/ship-jobs-bullmq",
  "version": "0.2.1",
  "description": "BullMQ job backend, Redis lock provider and OpenTelemetry metrics for Ship declared jobs",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "lib/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs && tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run --root ../.. packages/jobs-bullmq/src --exclude '**/*.integration.test.ts'",
    "test:coverage": "vitest run --root ../.. packages/jobs-bullmq/src --exclude '**/*.integration.test.ts' --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "bullmq": "^5.76.3"
  },
  "peerDependencies": {
    "@sixthsummit/ship-core": "workspace:^",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@sixthsummit/ship-core": "workspace:*",
    "@sixthsummit/ship-drizzle": "workspace:^",
    "@sixthsummit/ship-testing": "workspace:^",
    "@types/pg": "^8.15.6",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "pg": "^8.16.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.20.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SixthSummit/Ship.git",
    "directory": "packages/jobs-bullmq"
  }
}
